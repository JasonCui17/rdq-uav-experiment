__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
outputs/*
!outputs/.gitkeep
!outputs/rdq_stage1_summary.csv
!outputs/rdq_stage2_interventions.csv
!outputs/rdq_stage3_multiseed.csv

# Dataset-derived manifests are reproducible and may contain annotations.
manifests*/*
!manifests/.gitkeep

# Local calibration caches and visualizations contain dataset imagery or
# derived annotations. Keep only the compact JSON calibration parameters.
calibration/cache/
calibration/annotation_site/
calibration/official_overlays/
calibration/*.csv
calibration/*.jpg

# Model/data artifacts must never enter ordinary Git history.
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz

# Local environment and editor files.
.env
.env.*
*.log
