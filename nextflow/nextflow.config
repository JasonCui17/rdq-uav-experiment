params {
    project_root       = "${baseDir}/.."
    config             = System.getenv('RDQ_CONFIG') ?: "${project_root}/configs/multimodal_v1/e5_annotated20_lightning.yaml"
    manifest           = System.getenv('RDQ_ANNOTATION_MANIFEST') ?: "${project_root}/manifests/multimodal_v1/vision_annotated20.jsonl"
    split              = System.getenv('RDQ_SPLIT_FILE') ?: "${project_root}/splits/mmaud_annotated20.json"
    outdir             = System.getenv('RDQ_NEXTFLOW_OUTDIR') ?: "${project_root}/outputs/own_multimodal_research/multimodal_v1/nextflow_e5"
    conda_env          = System.getenv('RDQ_CONDA_ENV') ?: System.getenv('CONDA_PREFIX') ?: 'rdq'
    epochs             = 12
    batch_size         = 1
    accumulate         = 4
    num_workers        = 2
    train_limit        = 0
    val_limit          = 0
    precision          = '16-mixed'
    git_commit         = System.getenv('RDQ_GIT_COMMIT') ?: 'UNSET'
    source_fingerprint = System.getenv('RDQ_SOURCE_FINGERPRINT') ?: 'UNSET'
    data_version       = System.getenv('RDQ_DATA_VERSION') ?: 'MMAUD-official-train-UNSET'
    test_train_sequence = ''
    test_val_sequence   = ''
    cache_buster       = 'v1'
    report_revision    = 'v1'
}

manifest {
    name = 'rdq-uav/multimodal-v1-e5'
    version = '1.0.0'
    nextflowVersion = '>=24.10.0, <24.11.0'
}

workDir = "${baseDir}/work"

process {
    executor = 'local'
    conda = params.conda_env
    errorStrategy = 'terminate'
    cache = true

    withLabel: 'process_low' {
        cpus = 2
        memory = '4 GB'
        time = '30 min'
    }
    withLabel: 'process_gpu' {
        cpus = 4
        memory = '16 GB'
        time = '7 d'
        accelerator = 1
        maxForks = 1
    }
}

executor {
    name = 'local'
    queueSize = 2
}

conda {
    enabled = true
    useMamba = false
    cacheDir = "${baseDir}/.conda_cache"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.tsv"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/workflow_dag.html"
    overwrite = true
}

profiles {
    standard {
        process.executor = 'local'
    }
    test {
        params.outdir = "${baseDir}/results/test"
        params.epochs = 1
        params.train_limit = 2
        params.val_limit = 2
        params.num_workers = 0
        params.batch_size = 1
        params.accumulate = 1
        params.precision = '16-mixed'
        params.test_train_sequence = 'seq0001'
        params.test_val_sequence = 'seq0007'
        process {
            withLabel: 'process_gpu' {
                cpus = 2
                memory = '12 GB'
                time = '2 h'
                accelerator = 1
                maxForks = 1
            }
        }
    }
}
